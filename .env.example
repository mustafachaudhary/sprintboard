# ---- SprintBoard environment variables ----
# Copy this file to `.env` (server/.env) and adjust values.

# PostgreSQL connection string.
# Local (embedded PostgreSQL, started with `npm run postgres`):
DATABASE_URL=postgres://sprintboard:sprintboard_dev_password@localhost:54329/sprintboard

# For a hosted free-tier database (e.g. Neon), replace the line above with your
# provider's connection string, e.g.:
# DATABASE_URL=postgres://user:password@ep-xxx.aws.neon.tech/sprintboard?sslmode=require

# Secret used to sign session cookies. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Port the Express API listens on (Vite proxies /api here in development).
PORT=3001

# Node environment: development | production | test
NODE_ENV=development
